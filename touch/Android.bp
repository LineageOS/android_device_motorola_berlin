cc_binary {
    name: "vendor.lineage.touch-service.berlin",
    init_rc: ["vendor.lineage.touch-service.berlin.rc"],

    relative_install_path: "hw",
    proprietary: true,
    srcs: [
        "HighTouchPollingRate.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "liblog",
        "libutils",
        "vendor.lineage.touch-V1-ndk",
    ],
}
